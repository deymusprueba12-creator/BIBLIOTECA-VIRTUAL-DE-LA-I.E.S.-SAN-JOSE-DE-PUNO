# =============================================================================
# BIBLIOTECA VIRTUAL DE LA I.E.S. SAN JOSÉ DE PUNO
# Plantilla de variables para generar config.js del frontend.
#
# Copia este archivo como ".env" y ajusta los valores:
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (Linux/macOS)
#
# Después ejecuta:
#   node scripts/generar-config.mjs
#
# Este archivo NO contiene contraseñas. Las credenciales de demostración se
# configuran en servidor/.env y las valida el servidor con scrypt.
# =============================================================================

# URL pública del API (sin barra final).
# En local, la misma que PUERTO de servidor/.env.
API_URL=http://127.0.0.1:3210

# Límite por archivo en MB. Debe coincidir con TAMANO_MAXIMO_MB del servidor.
# 1 GB por defecto para servidores con disco suficiente.
TAMANO_MAXIMO_MB=1024
