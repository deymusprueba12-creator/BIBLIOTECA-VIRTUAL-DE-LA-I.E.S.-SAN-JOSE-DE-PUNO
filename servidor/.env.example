# =============================================================================
# SERVIDOR DE LA BIBLIOTECA VIRTUAL DE LA I.E.S. SAN JOSÉ DE PUNO
#
# Copia este archivo como `servidor/.env` y reemplaza los valores.
# `servidor/.env` está en .gitignore: nunca se sube al repositorio.
#
# Usa SOLO credenciales de demostración. No pongas contraseñas personales,
# institucionales ni reales: este proyecto es educativo.
# =============================================================================

# --- Servidor -----------------------------------------------------------------
PUERTO=3000
HOST=0.0.0.0

# --- Datos --------------------------------------------------------------------
# Carpeta donde se guardan la base SQLite y los archivos subidos.
# Por defecto: servidor/datos
#RUTA_DATOS=

# --- Usuarios iniciales -------------------------------------------------------
# Solo se crean si la tabla de usuarios está vacía.
DOCENTE_USUARIO=cambia_este_usuario_docente
DOCENTE_PASSWORD=cambia_esta_contrasena_docente
DOCENTE_NOMBRE=Docente

ESTUDIANTE_USUARIO=cambia_este_usuario_estudiante
ESTUDIANTE_PASSWORD=cambia_esta_contrasena_estudiante
ESTUDIANTE_NOMBRE=Estudiante

# --- Límites y sesiones -------------------------------------------------------
# 100 MB por defecto (seguro en servers de 512 MB RAM). Para 1 GB ver DECISIONES.md.
TAMANO_MAXIMO_MB=100
DURACION_SESION_HORAS=12
LIMITE_INTENTOS=5
BLOQUEO_SEGUNDOS=60

# --- CORS ---------------------------------------------------------------------
# Orígenes del frontend separados por comas. Añade aquí el dominio de GitHub
# Pages cuando publiques, por ejemplo: https://mi-usuario.github.io
ORIGENES_PERMITIDOS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8099,http://localhost:8099
